{
  "name": "meshlet-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch WebGPU and WebAssembly meshlet rendering benchmark",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build:wasm": "node wasm/build-bounds.mjs",
    "test": "node --test tests/*.test.mjs",
    "benchmark:planet": "node scripts/benchmark-planet-selection.mjs && node scripts/benchmark-planet-transitions.mjs",
    "check": "npm run build:wasm && npm run check:syntax && npm run check:wgsl && npm test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:wgsl": "node --no-warnings scripts/check-wgsl.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "naga-wasi-cli": "0.1.0"
  }
}
